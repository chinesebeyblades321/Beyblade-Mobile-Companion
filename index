/* ---------- beys ---------- */
var curFilter="all", curSort="elo";
function renderBeys(){
  var q=(document.getElementById("search").value||"").toLowerCase().trim();
  var list=BEYS.filter(function(b){
    if(curFilter!=="all" && b.type!==curFilter) return false;
    if(q && b.name.toLowerCase().indexOf(q)===-1) return false;
    return true;
  });
  var sorted=list.slice();
  if(curSort==="elo") sorted.sort(function(a,b){return b.elo-a.elo;});
  if(curSort==="wins") sorted.sort(function(a,b){return b.w-a.w || b.elo-a.elo;});
  if(curSort==="winpct") sorted.sort(function(a,b){return winPct(b)-winPct(a) || b.elo-a.elo;});
  if(curSort==="peak") sorted.sort(function(a,b){return b.peak-a.peak;});
  if(curSort==="points") sorted.sort(function(a,b){return b.pf-a.pf || b.elo-a.elo;});
  if(curSort==="name") sorted.sort(function(a,b){return a.name<b.name?-1:1;});
  document.getElementById("beyList").innerHTML = sorted.map(function(b){ return rankRow(b,true); }).join("");
  document.getElementById("beyEmpty").style.display = sorted.length? "none":"block";
  document.getElementById("beyCount").textContent = sorted.length+" shown";
  document.getElementById("sortNote").textContent = curSort==="elo" ? "RANKS ARE TRUE S2 RANKS" : "RANKS STAY TRUE S2 RANKS";
  bindAll();
}

/* ---------- profile ---------- */
function sparkSvg(id){
  var h=(DATA.hist[String(id)]||[]).slice();
  var pts=[1200].concat(h);
  if(pts.length<2) return "";
  var W=320,H=84,PAD=8;
  var min=Math.min.apply(null,pts), max=Math.max.apply(null,pts);
  min-=12; max+=12;
  var coords=pts.map(function(p,i){ var x=PAD+i*(W-2*PAD)/(pts.length-1); var y=H-PAD-((p-min)/(max-min))*(H-2*PAD); return x.toFixed(1)+","+y.toFixed(1); }).join(" ");
  var last=coords.split(" ").pop().split(",");
  return '<svg viewBox="0 0 '+W+' '+H+'" width="100%" height="84" role="img" aria-label="Elo history chart"><polyline points="'+coords+'" fill="none" style="stroke:var(--accent)" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round"/><circle cx="'+last[0]+'" cy="'+last[1]+'" r="4.5" style="fill:var(--ink);stroke:var(--phone-bg)" stroke-width="1.5"/></svg>'
    +'<div style="display:flex;justify-content:space-between;font-family:var(--mono);font-size:10px;color:var(--muted)"><span>START 1200 • LOW '+fmt(Math.min.apply(null,pts))+'</span><span>PEAK '+fmt(Math.max.apply(null,pts))+' • NOW '+fmt(pts[pts.length-1])+'</span></div>';
}
