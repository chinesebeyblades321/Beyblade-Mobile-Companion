/* ---------- compare ---------- */
function expected(a,b){ return 1/(1+Math.pow(10,(b-a)/400)); }
function h2hFor(a,b){
  var key=Math.min(a,b)+"-"+Math.max(a,b);
  return DATA.h2h[key]||null;
}
function setCompare(a,b){
  document.getElementById("pickA").value=String(a);
  document.getElementById("pickB").value=String(b);
  updateCompare();
}
function statRow(label, va, vb, higherBetter){
  var ca="", cb="";
  if(va!==vb){ if(higherBetter){ ca=va>vb?"better":""; cb=vb>va?"better":""; } else { ca=va<vb?"better":""; cb=vb<va?"better":""; } }
  return '<tr><td>'+label+'</td><td class="'+ca+'">'+va+'</td><td class="'+cb+'">'+vb+'</td></tr>';
}
function updateCompare(){
  var a=B(parseInt(document.getElementById("pickA").value,10));
  var b=B(parseInt(document.getElementById("pickB").value,10));
  if(!a||!b) return;
  document.getElementById("openA").textContent="Open "+a.name+"’s profile →";
  if(a.id===b.id){
    document.getElementById("nameA").textContent=a.name; document.getElementById("nameB").textContent=b.name;
    document.getElementById("pctA").textContent="—"; document.getElementById("pctB").textContent="—";
    document.getElementById("evidence").innerHTML="<b>Pick two different beys</b> to run the predictor.";
    document.getElementById("h2h").innerHTML=""; document.getElementById("cmpTable").innerHTML=""; document.getElementById("h2hNote").innerHTML="";
    return;
  }
  var pa=expected(a.elo,b.elo), pb=1-pa;
  document.getElementById("nameA").textContent=a.name; document.getElementById("nameB").textContent=b.name;
  document.getElementById("pctA").textContent=(pa*100).toFixed(1)+"%";
  document.getElementById("pctB").textContent=(pb*100).toFixed(1)+"%";
  document.getElementById("barA").style.width=(pa*100)+"%";
  document.getElementById("barB").style.width=(pb*100)+"%";
  document.getElementById("eloA").textContent=fmt(a.elo)+" ELO • RANK #"+rankOf[a.id];
  document.getElementById("eloB").textContent=fmt(b.elo)+" ELO • RANK #"+rankOf[b.id];
  var h=h2hFor(a.id,b.id);
  var meetings=h? h.m:0;
  var minMatches=Math.min(a.mp,b.mp);
  var score=minMatches+2*meetings;
  var tier=score>=20?"Strong":(score>=10?"Moderate":"Limited");
  var fav = pa>=0.5? a:b, dog = pa>=0.5? b:a;
  document.getElementById("evidence").innerHTML="<b>Evidence: "+tier+"</b> — score "+score+" = min matches ("+minMatches+") + 2 × head-to-head meetings ("+meetings+").<br>"
    +"The model leans <b>"+esc(fav.name)+"</b>"+(Math.abs(pa-0.5)<0.03? " by a coin-flip margin.":".")+" Win % is the Elo gap talking; Evidence is how much S2 data backs it up.";
  if(h){
    var wa = h.a===a.id? h.wa:h.wb, wb = h.a===a.id? h.wb:h.wa;
    var pta = h.a===a.id? h.pa:h.pb, ptb = h.a===a.id? h.pb:h.pa;
    document.getElementById("h2h").innerHTML='<div><b>'+wa+'–'+wb+'</b><span>Match record<br>'+esc(a.name)+' first</span></div><div><b>'+pta+'–'+ptb+'</b><span>Points<br>'+esc(a.name)+' first</span></div><div><b>'+meetings+'</b><span>Meetings<br>in S2</span></div>';
    document.getElementById("h2hNote").innerHTML='<p class="note">LAST MEETING — '+esc(h.lt).toUpperCase()+' • '+h.last+'. '+(wa===wb? "Dead level — the predictor is the tiebreaker.": (wa>wb? esc(a.name)+" owns this matchup so far.": esc(b.name)+" owns this matchup so far."))+'</p>';
  } else {
    document.getElementById("h2h").innerHTML='<div><b>0</b><span>Meetings<br>in S2</span></div><div><b>—</b><span>Match<br>record</span></div><div><b>—</b><span>Points</span></div>';
    document.getElementById("h2hNote").innerHTML='<p class="note">NEVER MET IN SEASON 2 — this prediction is pure Elo, no head-to-head data behind it. That’s exactly what the Evidence score is warning you about.</p>';
  }
  document.getElementById("cmpTable").innerHTML='<table class="cmp-table"><tr><th></th><th>'+esc(a.name)+'</th><th>'+esc(b.name)+'</th></tr>'
    +statRow("ELO", fmt(a.elo), fmt(b.elo), true)
    +statRow("PEAK", fmt(a.peak), fmt(b.peak), true)
    +statRow("RECORD", a.w+"–"+a.l, b.w+"–"+b.l, true)
    +statRow("WIN %", winPct(a)+"%", winPct(b)+"%", true)
    +statRow("MATCHES", a.mp, b.mp, true)
    +statRow("POINTS FOR", a.pf, b.pf, true)
    +statRow("POINTS AGAINST", a.pa, b.pa, false)
    +statRow("BEST STREAK", a.best, b.best, true)
    +statRow("KO WINS", DATA.kos[String(a.id)]||0, DATA.kos[String(b.id)]||0, true)
    +'</table>';
}

/* ---------- records ---------- */
function leaderBlock(elId, sorted, valFn, subFn){
  document.getElementById(elId).innerHTML = sorted.slice(0,5).map(function(b,i){
    return '<button class="leader-row" data-profile="'+b.id+'" type="button"><div class="rank-num '+(i===0?"top":"")+'">'+(i+1)+'</div><div style="min-width:0"><b>'+esc(b.name)+'</b><small>'+subFn(b)+'</small></div><div class="val">'+valFn(b)+'</div></button>';
  }).join("");
}
function renderRecords(){
  leaderBlock("leadElo", BEYS.slice(), function(b){return fmt(b.elo);}, function(b){return "#"+rankOf[b.id]+" • "+b.w+"–"+b.l+" • "+esc(b.type);});
  leaderBlock("leadWins", BEYS.slice().sort(function(x,y){return y.w-x.w||y.elo-x.elo;}), function(b){return b.w+" W";}, function(b){return b.mp+" matches • "+winPct(b)+"% • "+fmt(b.elo)+" Elo";});
  leaderBlock("leadPct", BEYS.filter(function(b){return b.mp>=10;}).sort(function(x,y){return winPct(y)-winPct(x)||y.elo-x.elo;}), function(b){return winPct(b)+"%";}, function(b){return b.w+"–"+b.l+" in "+b.mp+" matches";});
  leaderBlock("leadPts", BEYS.slice().sort(function(x,y){return y.pf-x.pf||y.elo-x.elo;}), function(b){return b.pf+" pts";}, function(b){return b.pa+" against • "+b.mp+" matches";});
  // tiers: S top 8, A next 15, B next 22, C next 18, D last 11
  var bands=[["S","s",0,8,"Top 10% — the title picture"],["A","a",8,23,"Next 20% — one run from S"],["B","b",23,45,"Next 30% — the crowded middle"],["C","c",45,63,"Next 25% — climbing or sliding"],["D","d",63,74,"Bottom 15% — rebuild territory"]];
  document.getElementById("tierList").innerHTML = bands.map(function(band){
    var members=BEYS.slice(band[2],band[3]);
    return '<div class="tier"><div class="tier-badge '+band[1]+'">'+band[0]+'</div><div style="flex:1;min-width:0"><h4>'+band[0]+' Tier — '+members.length+' beys</h4><p>'+band[4]+' • Elo '+fmt(members[0].elo)+' → '+fmt(members[members.length-1].elo)+'</p><div class="tier-chips">'
      +members.map(function(b){ return '<button data-profile="'+b.id+'" type="button">'+esc(b.name)+' '+fmt(b.elo)+'</button>'; }).join("")+'</div></div></div>';
  }).join("");
  document.getElementById("rivalList").innerHTML = DATA.rivalries.map(function(r,i){
    var na=nameOf(r.a), nb=nameOf(r.b);
    var rec = r.wa+"–"+r.wb;
    return '<button class="rival" data-compare="'+r.a+'-'+r.b+'" type="button"><b>#'+(i+1)+' '+esc(na)+' vs '+esc(nb)+'</b><span class="meta">'+r.m+' MEETINGS • RECORD '+rec+' ('+esc(na)+' FIRST) • POINTS '+r.pa+'–'+r.pb+'<br>LAST MET: '+esc(r.lt).toUpperCase()+' • '+r.last+' • TAP TO COMPARE →</span></button>';
  }).join("");
  var awards=[
    {icon:"★", label:"Rebirth Champion", bey:24, val:"Meteo L Drago", sub:"Beat Orochi twice on finals day — 5–4, then 5–2 in the reset."},
    {icon:"★", label:"Aftershock Champion", bey:61, val:"Orochi", sub:"Beat Phenix 6–4 in the Grand Final. Runner-up at Rebirth, champion at Aftershock."},
    {icon:"★", label:"Eclipse Champion", bey:71, val:"Bahamoot", sub:"Seed 28, and 33rd at Aftershock. Lost to Orochi in the winners bracket, ran the losers side, then beat him twice in the Grand Finals — 6–2 and 5–3."},
    {icon:"◈", label:"Highest Peak Elo — So far", bey:61, val:"Orochi — 1507.4", sub:"The first bey in S2 past 1500, set during the Eclipse winners run. Currently 1447.6 after the two Grand Final losses."},
    {icon:"↗", label:"Longest Win Streak — So far", bey:61, val:"Orochi — 13 straight", sub:"Seven to close Aftershock, six more at Eclipse — passing Meteo’s 12. Bahamoot’s active 5 is the longest current streak."},
    {icon:"W", label:"Most Wins — So far", bey:24, val:"Meteo L Drago — 22 wins", sub:"22–5 in 27 matches, still the most appearances of any bey in S2."},
    {icon:"P", label:"Most Points — So far", bey:61, val:"Orochi — 81 points", sub:"81 scored, 40 conceded in 23 matches across three finals runs."},
    {icon:"KO", label:"Most KO Finishes — So far", bey:61, val:"Orochi — 20 KOs", sub:"20 knockout round-wins, ahead of Phenix (18) and Bahamoot (17)."},
    {icon:"▲", label:"Biggest Upset — So far", bey:57, val:"L Drago Verdantis over Meteo L Drago", sub:"4–2 at a 175.2 Elo deficit in the Eclipse winners bracket — passing Phenix’s 142.4 from Aftershock."},
    {icon:"⇑", label:"Biggest Single-Match Climb — So far", bey:33, val:"Blitz Prototype — +38.7 Elo", sub:"Earned in a 4–0 over Phenix at Eclipse — itself a 162.5-point upset, the second-biggest of S2."},
    {icon:"⇑", label:"Biggest Eclipse Swing — So far", bey:71, val:"Bahamoot — +227.8 Elo at Eclipse", sub:"From 1205.7 and 33rd at Aftershock to Eclipse champion and #2 overall in one event."},
    {icon:"#1", label:"Current #1 — So far", bey:61, val:"Orochi — 1447.6", sub:"19–4, and the only bey to reach all three S2 finals: runner-up, champion, runner-up."}
  ];
  document.getElementById("awardList").innerHTML = awards.map(function(a){
    return '<button class="award" data-profile="'+a.bey+'" type="button"><div class="award-icon">'+a.icon+'</div><div style="min-width:0"><small>'+a.label+'</small><b>'+a.val+'</b><span>'+a.sub+'</span></div></button>';
  }).join("");
}
function setRecTab(tab){
  var tabs=document.querySelectorAll(".rec-tab");
  for(var i=0;i<tabs.length;i++) tabs[i].classList.toggle("active", tabs[i].getAttribute("data-rec")===tab);
  var panels=document.querySelectorAll(".rec-panel");
  for(var j=0;j< panels.length;j++) panels[j].classList.remove("active");
  var p=document.getElementById("rec-"+tab); if(p) p.classList.add("active");
  bindAll();
}

/* ---------- wire up ---------- */
function fillSelects(){
  var opts=BEYS.map(function(b){ return '<option value="'+b.id+'">'+esc(b.name)+' ('+fmt(b.elo)+')</option>'; }).join("");
  document.getElementById("pickA").innerHTML=opts;
  document.getElementById("pickB").innerHTML=opts;
}
function randomPair(){
  var a=BEYS[Math.floor(Math.random()*BEYS.length)], b;
  do{ b=BEYS[Math.floor(Math.random()*BEYS.length)]; }while(b.id===a.id);
  setCompare(a.id,b.id); go("compare"); toast("Random: "+a.name+" vs "+b.name);
}
document.querySelectorAll(".nav-btn").forEach(function(btn){ btn.addEventListener("click",function(){ go(btn.getAttribute("data-nav")); }); });
document.getElementById("profileBack").addEventListener("click",function(){ go(profileReturn==="profile"?"beys":profileReturn); });
document.getElementById("search").addEventListener("input",renderBeys);
document.querySelectorAll("#typeChips .chip").forEach(function(chip){ chip.addEventListener("click",function(){ document.querySelectorAll("#typeChips .chip").forEach(function(c){c.classList.remove("active");}); chip.classList.add("active"); curFilter=chip.getAttribute("data-filter"); renderBeys(); }); });
document.getElementById("sortSel").addEventListener("change",function(){ curSort=this.value; renderBeys(); });
document.getElementById("pickA").addEventListener("change",updateCompare);
document.getElementById("pickB").addEventListener("change",updateCompare);
document.getElementById("swapBtn").addEventListener("click",function(){ var a=document.getElementById("pickA").value; document.getElementById("pickA").value=document.getElementById("pickB").value; document.getElementById("pickB").value=a; updateCompare(); });
document.getElementById("openA").addEventListener("click",function(){ openProfile(parseInt(document.getElementById("pickA").value,10),"compare"); });
document.getElementById("randomBtn").addEventListener("click",randomPair);
document.getElementById("randomBtn2").addEventListener("click",randomPair);
document.querySelectorAll(".rec-tab").forEach(function(t){ t.addEventListener("click",function(){ setRecTab(t.getAttribute("data-rec")); }); });

/* ---------- install (PWA) ---------- */
document.getElementById("installBtn").addEventListener("click",function(){
  document.getElementById("installHelp").classList.toggle("show");
});
if(window.matchMedia && window.matchMedia("(display-mode: standalone)").matches){ document.getElementById("installBtn").style.display="none"; }

/* ---------- init ---------- */
renderHome(); renderBeys(); renderRecords(); fillSelects(); setCompare(61,71); bindAll();
</script>
</body>
